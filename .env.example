# mock (default): in-memory stand-in, no backend needed
# http: talk to the app server
VITE_API_MODE=mock

# Where "Powered by WALRUS" in the tuning panel links to. Defaults to the WALRUS website.
# VITE_WALRUS_SITE_URL=https://walrusyours.github.io/

# Base URL of the app server API. Leave unset to use /api (nginx proxies it to the app
# server in compose). For `npm run dev` against a local app server:
# VITE_API_URL=http://localhost:8081
